{"created": "2026-10-31T14:03:26.098189+00:00", "modified": "2026-10-31T14:03:26.449204+00:00", "id": 23838097, "conceptrecid": "23838096", "doi": "10.5281/zenodo.23838097", "conceptdoi": "10.5281/zenodo.23838096", "doi_url": "https://doi.org/10.5281/zenodo.23838097", "metadata": {"title": "Corporate Cognitive Warfare: Irregular Warfare for Market Supremacy (Whitepaper, Expanded Edition)", "doi": "10.5281/zenodo.23838097", "publication_date": "2026-10-31", "description": "<p>Corporate Cognitive Warfare, a term coined by William Aaron Turner, Founder &amp; President of Infinitum Corporation, is the strategic use of irregular warfare principles to shape how customers, employees, investors, regulators and the public perceive and decide, and to defend an organization against hostile influence. This expanded edition grounds the concept in a neutral review of published military literature: Russian reflexive control theory, Chinese cognitive domain operations and the \"three warfares,\" and NATO research on cognitive warfare. It translates their analytical lessons into lawful corporate practice across five disciplines: guerrilla marketing, persuasion psychology, algorithmic optimization, social influence and targeted advertising, each mapped to FTC, GDPR, DSA, CCPA and platform rules. Twelve illustrative use cases show the six-phase framework of Understand, Shape, Seed, Amplify, Exploit and Protect in practice. A defensive playbook covers narrative sensing, prebunking, decision hygiene and response. Deceptive tactics such as fake accounts, bots, astroturfing and disinformation are treated only as threats.</p>", "access_right": "open", "creators": [{"name": "Turner, William Aaron", "affiliation": "Infinitum Corporation", "orcid": "0009-0002-1585-5442"}], "keywords": ["Corporate Cognitive Warfare", "cognitive warfare", "reflexive control", "cognitive domain operations", "irregular warfare", "information operations", "strategic communications", "disinformation defense", "reputation management"], "related_identifiers": [{"identifier": "https://www.academia.edu/179983771/Corporate_Cognitive_Warfare_Irregular_Warfare_for_Market_Supremacy_Whitepaper_Expanded_Edition_", "relation": "isIdenticalTo", "resource_type": "publication-report", "scheme": "url"}], "resource_type": {"title": "Report", "type": "publication", "subtype": "report"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 0, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "23838096"}}]}}, "title": "Corporate Cognitive Warfare: Irregular Warfare for Market Supremacy (Whitepaper, Expanded Edition)", "links": {"self": "https://zenodo.org/api/records/23838097", "self_html": "https://zenodo.org/records/23838097", "preview_html": "https://zenodo.org/records/23838097?preview=1", "doi": "https://doi.org/10.5281/zenodo.23838097", "self_doi": "https://doi.org/10.5281/zenodo.23838097", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23838097", "reserve_doi": "https://zenodo.org/api/records/23838097/draft/pids/doi", "parent": "https://zenodo.org/api/records/23838096", "parent_html": "https://zenodo.org/records/23838096", "parent_doi": "https://doi.org/10.5281/zenodo.23838096", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.23838096", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:23838097/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:23838097/sequence/default", "files": "https://zenodo.org/api/records/23838097/files", "media_files": "https://zenodo.org/api/records/23838097/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:23838097:Infinitum-Whitepaper-Corporate-Cognitive-Warfare-EXPANDED-RELEASE.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:23838097:Infinitum-Whitepaper-Corporate-Cognitive-Warfare-EXPANDED-RELEASE.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:23838097:Infinitum-Whitepaper-Corporate-Cognitive-Warfare-EXPANDED-RELEA