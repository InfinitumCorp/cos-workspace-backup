<script>
document.addEventListener('DOMContentLoaded', function() {
    var currentHost = window.location.hostname;
    var links = document.querySelectorAll('a[href]');

    links.forEach(function(link) {
        var href = link.getAttribute('href');

        if (!href || href.startsWith('#') || href.startsWith('mailto:') || href.startsWith('tel:') || href.startsWith('javascript:')) {
            return;
        }

        try {
            var url = new URL(href, window.location.origin);

            if (url.hostname && url.hostname !== currentHost) {
                link.setAttribute('target', '_blank');

                var existingRel = (link.getAttribute('rel') || '').split(/\s+/).filter(Boolean);
                ['noopener', 'noreferrer'].forEach(function(value) {
                    if (!existingRel.includes(value)) {
                        existingRel.push(value);
                    }
                });
                link.setAttribute('rel', existingRel.join(' '));
            }
        } catch (error) {
            // Ignore malformed URLs and leave the link untouched.
        }
    });

    var forms = document.querySelectorAll('#drip-signup-form, #drip-global-signup-form');
    
    forms.forEach(function(form) {
        if (!form) return;
        
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            var email = form.querySelector('input[type="email"]').value.trim();
            // Remove any existing messages first
            while (form.nextElementSibling && form.nextElementSibling.classList.contains('form-message')) {
                form.nextElementSibling.remove();
            }

            // Validate email
            if (!email) {
                const errorDiv = Object.assign(document.createElement('div'), {
                    textContent: 'Please enter an email address',
                    className: 'form-message', 
                    style: 'color: #ff0000; margin-top: 10px; font-size: 14px; display: block;'
                });
                form.insertAdjacentElement('afterend', errorDiv);
                return;
            }

            // Show loading message
            const loadingDiv = Object.assign(document.createElement('div'), {
                textContent: 'Submitting...',
                className: 'form-message', 
                style: 'color: #333; margin-top: 10px; font-size: 14px; display: block;'
            });
            form.insertAdjacentElement('afterend', loadingDiv);

            var tag = form.querySelector('input[name="tag"]')?.value || 'dailynewsletter';

            var honeypot = form.querySelector('input[name="website"]');

            fetch("https:\/\/warontherocks.com\/wp-json\/wotr\/v1\/newsletter\/subscribe", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    email: email,
                    tag: tag,
                    website: honeypot ? honeypot.value : ''
                })
            })
            .then(response => response.json().then(data => ({status: response.status, body: data})))
            .then(({status, body}) => {
                loadingDiv.remove();
                if (status >= 200 && status < 300) {
                    // Only show success message if form is still visible
                    if (form.parentElement) {
                        const thankYouDiv = Object.assign(document.createElement('div'), {
                            textContent: 'Thank you for signing up! Check your inbox to confirm.',
                            className: 'form-message',
                            style: 'color: #4CAF50; margin-top: 10px; font-size: 14px; display: block;'
                        });
                        form.insertAdjacentElement('afterend', thankYouDiv);
                        form.reset();
                    }
                } else {
                    var messages = {
                        invalid_email: 'Please enter a valid email address.',
                        rate_limited: 'Too many attempts. Please try again in a few minutes.'
                    };
                    const errorDiv = Object.assign(document.createElement('div'), {
                        textContent: messages[body.error] || 'There was an error signing up. Please try again.',
                        className: 'form-message',
                        style: 'color: #ff0000; margin-top: 10px; font-size: 14px; display: block;'
                    });
                    form.insertAdjacentElement('afterend', errorDiv);
                    console.error('Newsletter signup error:', body);
                }
            })
            .catch(error => {
                loadingDiv.remove();
                const errorDiv = Object.assign(document.createElement('div'), {
                    textContent: 'There was an error signing up. Please try again.',
                    className: 'form-message',
                    style: 'color: #ff0000; margin-top: 10px; font-size: 14px; display: block;'
                });
                form.insertAdjacentElement('afterend', errorDiv);
                console.error('Newsletter signup fetch error:', error);
            });
        });
    });
});
</script>

<!-- trustarc autoblock js -->
<script>
window.addEventListener("message", function(event) {
	var eventDataJson = null;
	// We only care about TrustArc Events at this point. And TrustArc's even it encoded in JSON
	try {
		eventDataJson = JSON.parse(event.data);
	} catch (e) {
		// Some other event that is not JSON.
		// TrustArc encodes the data as JSON
		 console.log(event.data);
	}
	// Safeguard to make sure we are only getting events from TrustArc
	if (eventDataJson && eventDataJson.source === "preference_manager") {
		// Means that the user has submited their preferences
		if (eventDataJson.message === "submit_preferences") {
			setTimeout(function() {
				window.location.reload();
			}, 20);
		}
	}
}, false);
</script>
