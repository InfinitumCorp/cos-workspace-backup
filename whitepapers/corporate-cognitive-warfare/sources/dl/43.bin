			.page-id-35565 img.wp-image-35563 {
  display: none !important;
}

/*Cogs of War Header Whitespace Fix*/
.category-cogs-of-war header {
	max-width:100%;
}

/*bylines fixes for category meta*/

.wotr-byline,
.wotr-byline span,
.wotr-byline a {
  color: var(--dynamic-subtle-color, #585a66) !important;
  font-weight: 600;
}

.wotr-byline .bylines-meta .bylines-connector {
    color: inherit !important;
}

/*popup missing styles*/

.wotrpromo-body h4 {
	text-align: center;
	font-family: "ivar text"; //rubik
	font-weight: 600;
}

.wotrpromo-body p {
font-family: "ivar text";
	color: #000000 
}

/* Adjust popup size on smaller screens */
@media screen and (max-width: 480px) {
  .your-popup-class {
    width: 90% !important;
    height: auto !important;
    max-height: 80vh !important; 
    overflow-y: auto !important; 
  }
}

/*making sure x doesn't get pushed off screen for popup*/
@media screen and (max-width: 480px) {
  .your-popup-class .close-button {
    position: absolute !important;
    top: 10px;
    right: 10px;
    z-index: 9999;
  }
}

/*fixing missing h2/h3/h4 fonts*/

.tw\:font-ivar-text\! h2,
.tw\:font-ivar-text\! h3,
.tw\:font-ivar-text\! h4,
.tw\:font-ivar-text\! h5,
.tw\:font-ivar-text\! h6 {
    font-family: var(--tw-font-ivar-text) !important;
}

/* video web display */
.wp-video {
    width: auto !important;
    height: auto !important;
    max-width: 400px !important;
    margin: 20px auto;
    text-align: center;
    display: inline-block;
}
.wp-video video {
    width: 100% !important;
    height: auto !important;
    max-width: 400px !important;
}


/*hotfix membership page*/
.page-id-14303 .wp-block-button__container:has(#supportingcast-widget) {
      display: block;
      width: 100%;
      max-width: 100%;
  }
  
  .page-id-14303 #supportingcast-widget {
      display: block;
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
  }
  
  .page-id-14303 #supportingcast-widget .sc-widget {
      width: 100%;
      max-width: 1024px;
  }



/* Updated print CSS to show full video */
@media print {
    .wp-video {
        page-break-inside: avoid;
        width: auto !important;
        height: auto !important;
        max-width: 300px !important; 
        margin: 15px auto !important;
        overflow: visible !important;
        background: white !important;
    }
    
    .wp-video video {
        width: 100% !important;
        height: auto !important;
        max-width: 300px !important; 
        max-height: none !important; 
        object-fit: contain;
        display: block !important;
    }
    

    .wp-video + p,
    .wp-video + div {
        margin-top: 15px !important;
    }
}

