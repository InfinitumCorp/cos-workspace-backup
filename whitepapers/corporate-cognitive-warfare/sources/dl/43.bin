                <!-- Free Content Section - 1 grid columns -->
                <div class="tw:col-span-1 tw:items-center tw:justify-between tw:space-y-4">
                    <div class="tw:inline-block tw:text-white tw:text-sm tw:font-bold! tw:font-inter tw:mt-0! tw:mb-4">Featured Content</div>
                    <ul class="tw:list-none tw:p-0! tw:m-0! tw:gap-4 tw:space-y-2">
