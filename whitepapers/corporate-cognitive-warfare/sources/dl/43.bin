<script src="https://warontherocks.com/wp-content/themes/warontherocks/assets/home2019/jquery.js"></script>
<script>
function flint_code() {
    const $subscribe = $('.subscribe');
    const $searchbar = $('.searchbar');
    const $newMenu = $('.new_menu');
    const $navOpener = $('.nav-opener');
    const $popup = $('.popup');
    const $latestPosts = $('.latest-posts');
    const $podcasts = $('.podcasts');
    const $tnsrPosts = $('.tnsr-posts');

    $subscribe.find('button').on('click touch', () => {
        $subscribe.find('.hidden-sighup').addClass('active');
    });

    $('.expand-form').on('click touch', function() {
        $searchbar.find('input, button').toggleClass('active');
        $(this).toggleClass('hidden');
    });

    $('.hamburger').on('click touch', () => {
        $newMenu.toggleClass('active');
        $navOpener.toggleClass('active');
    });

    $('.got-it').on('click touch', () => {
        $popup.toggleClass('hidden');
        Cookies.set('wotr_new_v1', '1', { expires: 180 });
    });

    function switchContent($activeBtn, $showContent) {
        $('.podcasts-active, .wotr-active, .tnsr-active').removeClass('selected');
        $activeBtn.addClass('selected');
        $latestPosts.add($podcasts).add($tnsrPosts)
            .removeClass('active')
            .addClass('hidden');
        $showContent
            .removeClass('hidden')
            .addClass('active');
    }

    $('.podcasts-active').on('click touch', function() {
        switchContent($(this), $podcasts);
    });

    $('.wotr-active').on('click touch', function() {
        switchContent($(this), $latestPosts);
    });

    $('.tnsr-active').on('click touch', function() {
        switchContent($(this), $tnsrPosts);
    });
}

function init() {
    const js_version = "1.0.3";
    const script = document.createElement("script");
    script.src = "https://warontherocks.com/wp-content/themes/warontherocks/assets/js/script.js?v=" + js_version;
    document.body.appendChild(script);
    flint_code();
}

if (window.addEventListener) {
    window.addEventListener("load", init, false);
} else if (window.attachEvent) {
    window.attachEvent("onload", init);
} else {
    window.onload = init;
}
</script>
