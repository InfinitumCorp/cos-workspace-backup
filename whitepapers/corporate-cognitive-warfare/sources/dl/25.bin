<style id="wp-custom-css">
body:not(.page-id-518777):not(.parent-pageid-518777) .country-selector {
	display: none;
}

.country-selector {
position: fixed;
bottom: 0 !important;
right: 0 !important;
background: #fff;
}

.country-selector label {
display: inline-block !important;
padding: 0 8px !important;
}

.country-selector label:before,
.country-selector label:after {
content: none !important;
}

.country-selector ul {
vertical-align: baseline !important;
}

.weglot_switcher > div > a:after {
    content: '';
    display: inline-block;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    padding: 3px;
    transform: rotate(-135deg);
    margin: 0 0 0px 7px;
}

.weglot_switcher > div[aria-expanded="true"] > a:after {
	    transform: rotate(45deg);
    margin: 0 0 3px 7px;
}

.country-selector .wgcurrent{
    background-color: #006ce0 !important;
	color: white !important;
}

.country-selector.weglot-dropdown ul li a{
	background-color: #ffffff !important;
	color: black !important;
}

.country-selector.weglot-dropdown ul{
height: 392px;
  overflow-y: scroll;
	scrollbar-color: grey;
  scrollbar-width: thin;
}
</style>
</head>
